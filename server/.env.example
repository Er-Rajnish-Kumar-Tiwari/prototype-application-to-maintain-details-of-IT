# MongoDB connection string (Atlas or local). Aap apna URL yahan daal denge.
# NOTE: Yeh sirf example/template file hai - isme real username/password kabhi na daalein
# (yeh file git me commit hoti hai). Apna asli connection string sirf "server/.env"
# (gitignored, kabhi commit nahi hoti) file me daalein.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/it-asset-manager?retryWrites=true&w=majority

# Server port
PORT=5000

# JWT secret - production me ise ek strong random string se replace karein
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Default Head of Organization account created by the seed script
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin@123

# Default Department Staff account created by the seed script
STAFF_NAME=Department Staff
STAFF_EMAIL=staff@company.com
STAFF_PASSWORD=Staff@123
